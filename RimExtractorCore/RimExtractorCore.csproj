<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15</LangVersion>
    <RootNamespace>RimExtractorCore</RootNamespace>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    
    <!-- Build Configurations -->
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.2.0.10050" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="11.0.0" />
  </ItemGroup>
    
  <!-- Procedures 폴더 빌드 설정 -->
  <ItemGroup>
    
    <!-- Procedures 폴더에 있는 모든 .cs 파일 빌드에서 제외 -->
    <Compile Remove="Procedures\**\*.cs" />
    
    <!-- Procedure 인터페이스 정의 파일만 빌드에 포함 -->
    <Compile Include="Procedures\DefTree\IDefTreeProcedure.cs" />
    <Compile Include="Procedures\Translations\ITranslationEntryProcedure.cs" />
    <Compile Include="Procedures\Extractor\IExtractionProcedure.cs" />
    
    <!-- Procedure 구현 파일을 출력 디렉토리에 복사 -->
    <None Include="Procedures\**\*.cs" Exclude="Procedures\Extractor\IExtractionProcedure.cs;Procedures\Translations\ITranslationEntryProcedure.cs;Procedures\DefTree\IDefTreeProcedure.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    
  </ItemGroup>

</Project>
