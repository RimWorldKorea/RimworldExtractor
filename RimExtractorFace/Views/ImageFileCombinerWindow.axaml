<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RimExtractorFace.ViewModels"
        x:Class="RimExtractorFace.Views.ImageFileCombinerWindow"
        x:DataType="vm:ImageFileCombinerViewModel"
        Title="이미지 + 파일 합치기"
        Width="640"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto" Margin="10">
        <Grid Grid.Row="0" ColumnDefinitions="160, *, Auto" Margin="0,0,0,5">
            <TextBlock Grid.Column="0" Text="이미지 경로 (선택)" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding PathImage, Mode=TwoWay}" Margin="0,0,6,0"/>
            <Button Grid.Column="2" Content="..." Width="40" HorizontalContentAlignment="Center"
                    Command="{Binding SelectPathImageCommand}"
                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="160, *, Auto, Auto" Margin="0,5">
            <TextBlock Grid.Column="0" Text="합칠 파일 or 폴더 경로" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding PathFile, Mode=TwoWay}" Margin="0,0,6,0"/>
            <Button Grid.Column="2" Content="파일 지정" Margin="0,0,4,0"
                    Command="{Binding SelectPathFileCommand}"
                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
            <Button Grid.Column="3" Content="폴더 지정"
                    Command="{Binding SelectPathDirCommand}"
                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
        </Grid>

        <Border Grid.Row="2" Background="#252525" Margin="0,5" Padding="0,8">
            <TextBlock Text="이미지와 zip 압축 파일을 합치는 도구입니다.&#10;합친 이미지는 확장자를 zip으로 바꾸거나 압축 프로그램으로 열어 내용물을 꺼낼 수 있습니다.&#10;이미지 경로를 지정하지 않으면 기본 이미지가 적용됩니다.&#10;폴더 선택시 자동으로 압축 후 합쳐집니다."
                       TextAlignment="Center" LineHeight="20" Foreground="White"/>
        </Border>

        <Button Grid.Row="3" Content="합치기" Height="36" Margin="0,5,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Command="{Binding ProcessPackageCommand}"/>
    </Grid>
</Window>