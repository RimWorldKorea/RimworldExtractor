<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RimExtractorFace.ViewModels"
        x:Class="RimExtractorFace.Views.ImageFileCombinerWindow"
        x:DataType="vm:ImageFileCombinerViewModel"
        Title="이미지 + 파일 합치기 툴 (디시 업로드용)"
        Width="600" Height="260"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="160, *, Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="이미지 경로 지정 (선택)" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding PathImage, Mode=TwoWay}" Margin="0,0,6,0"/>
            <Button Grid.Column="2" Content="..." Width="40" HorizontalContentAlignment="Center"
                    Command="{Binding SelectPathImageCommand}"
                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="160, *, Auto, Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="합칠 파일/폴더 경로 지정" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding PathFile, Mode=TwoWay}" Margin="0,0,6,0"/>
            <Button Grid.Column="2" Content="파일 지정" Margin="0,0,4,0"
                    Command="{Binding SelectPathFileCommand}"
                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
            <Button Grid.Column="3" Content="폴더 지정"
                    Command="{Binding SelectPathDirCommand}"
                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
        </Grid>

        <Border Grid.Row="2" Background="#F8F8F8" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,8">
            <TextBlock Text="이미지 파일과 압축 파일(.zip)을 합치는 툴입니다.&#10;이미지의 확장자를 '.zip'으로 바꾸면 압축 파일 내부를 볼 수 있습니다.&#10;이미지 경로가 지정되지 않으면 기본 이미지가 사용됩니다.&#10;폴더가 선택되었다면 자동으로 압축 후 합쳐집니다."
                       TextAlignment="Center" LineHeight="20" Foreground="#555555"/>
        </Border>

        <Button Grid.Row="4" Content="완료" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Command="{Binding ProcessPackageCommand}"/>
    </Grid>
</Window>