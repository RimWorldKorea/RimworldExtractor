<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RimExtractorFace.ViewModels"
        xmlns:utils="clr-namespace:RimExtractorFace.Utils"
        x:Class="RimExtractorFace.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RimExtractor"
        Width="820" Height="520"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <utils:VersionColorConverter x:Key="VersionColorConverter" />
    </Window.Resources>

    <!-- RowDefinitions를 Auto, Auto, * 로 변경하여 마지막 행(로그 영역)이 남은 높이를 모두 차지하도록 수정 -->
    <Grid RowDefinitions="Auto, Auto, *" Margin="12">
        <!-- 상단 메뉴 및 선택된 모드 정보 (Row 0) -->
        <Grid Grid.Row="0" ColumnDefinitions="160, *, 160" Margin="0,0,0,10">
            
            <!-- 1. 왼쪽 메인 메뉴 버튼들 -->
            <StackPanel Grid.Column="0" Spacing="6">
                <Button Content="추출 모드 선택" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding SelectModCommand}"/>
                
                <Button Content="번역 파일 추출" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding ExtractCommand}"/>
                
                <Button Content="번역 분석기 (WIP)" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding OpenTranslationAnalyzerCommand}"/>
                
                <Button Content="9¾" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <!-- 2. 중앙 설명 및 선택된 모드 텍스트 -->
            <StackPanel Grid.Column="1" Margin="15,0,15,0" Spacing="8">
                <ScrollViewer Height="180" Background="Black" Padding="8">
                    <TextBlock Text="{Binding SelectedModsText}" TextWrapping="Wrap" TextAlignment="Center"/>
                </ScrollViewer>
            </StackPanel>

            <!-- 3. 우측 도구(유틸리티) 버튼들 -->
            <StackPanel Grid.Column="2" Spacing="6">
                <Button Content="XML -&gt; Sheet" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding ConvertToSheetCommand}"/>
                
                <Button Content="Sheet -&gt; XML" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding ConvertToXmlCommand}"/>
                
                <!-- 새로 추가된 검증 버튼 (기능 미연결) -->
                <Button Content="번역 기본 검증" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding InspectTranslationCommand}"/>
                
                <Button Content="이미지 + 파일&#10;합치기" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding OpenJpgPackagerCommand}"/>
            </StackPanel>
            
        </Grid>

        <!-- 중간 정보 / 링크 바 (Row 1) -->
        <Grid Grid.Row="1" Margin="0,5">
            
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="5">
                
                <Button Content="{Binding VersionText}"
                        Command="{Binding OpenVersionUrlCommand}"
                        Background="{Binding IsLatest,Converter={StaticResource VersionColorConverter}}"
                        Foreground="White"/>
                
                <Border Background="Goldenrod"
                        BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="4" 
                        Padding="6,0"
                        IsVisible="{Binding IsSpecialBuildIfNotEmpty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding IsSpecialBuildIfNotEmpty}" 
                               Foreground="Black" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Border>
                
            </StackPanel>
            
            <TextBlock Text="로그" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold"/>
            
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                
                <Button Content="일반 설정" 
                        Command="{Binding OpenSettingsCommand}" /> 
                
                <Button Content="프로시저 설정"
                        Command="{Binding OpenProcedureSettingsCommand}" />
                
                <Button Content="고객센터" 
                        Command="{Binding OpenDiscordUrlCommand}" />
                
            </StackPanel>
        </Grid>

        <!-- 하단 로그 터미널 Box (Row 2: 남은 세로 공간 자동 채움) -->
        <ScrollViewer Grid.Row="2" Name="LogScrollViewer" Background="Black" Margin="0,5,0,0">
            <SelectableTextBlock Name="TextBlockLog" 
                                 TextWrapping="Wrap"
                                 Foreground="White" 
                                 FontFamily="Consolas, Monospace, Courier New"
                                 Padding="4"/>
        </ScrollViewer>
    </Grid>
</Window>