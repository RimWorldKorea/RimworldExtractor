<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RimExtractorFace.ViewModels"
        x:Class="RimExtractorFace.Views.ProcedureSettingsWindow"
        x:DataType="vm:ProcedureSettingsViewModel"
        Title="프로시저 설정"
        Width="500" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- 1. 탭 헤더 기본 글자 크기 일괄 적용 -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,0,-2" />
        </Style>

        <!-- 마우스 오버 시 테마 기본 배경색 방지 -->
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        
        <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>

        <!-- 3. 탭이 선택되었을 때 테마 기본 배경색 지정 -->
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#252525" />
        </Style>
        
        <!-- 3. 탭이 선택되었을 때 테마 기본 배경색 지정 -->
        <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#252525" />
        </Style>

        <!-- 4. 탭이 선택되었을 때 헤더 하단의 강조선(Pipe) 색상 변경 -->
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Background" Value="#0078D7" />
        </Style>

        <!-- 5. TabControl 전체 배경은 투명하게 (창의 시스템 테마색이 비치게 함) -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- 6. 탭 하부의 콘텐츠 영역에만 #252525 배경과 위쪽 테두리 적용 -->
        <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>
    
    <Grid RowDefinitions="*, Auto" Margin="12">
        <TabControl Grid.Row="0">
            <!-- 1. DefTree 프로시저 (드래그-드롭 지원) -->
            <TabItem Header="DefTree">
                <ListBox ItemsSource="{Binding DefTreeProcedures}" Background="Transparent" 
                         DragDrop.AllowDrop="True" Name="DefTreeListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:ProcedureItemViewModel">
                            <Border Background="Transparent" PointerPressed="OnPointerPressed">
                                <Grid ColumnDefinitions="Auto, *, Auto" Margin="4,2">
                                    <TextBlock Grid.Column="0" Text="↕ " Foreground="Gray" VerticalAlignment="Center" ToolTip.Tip="드래그하여 순서를 변경하세요"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- 2. Extraction 프로시저 (단일 선택, 드래그-드롭 불필요) -->
            <TabItem Header="Extraction">
                <ListBox ItemsSource="{Binding ExtractionProcedures}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:ProcedureItemViewModel">
                            <Grid ColumnDefinitions="*, Auto" Margin="4,2">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- 3. TranslationEntry 프로시저 (드래그-드롭 지원) -->
            <TabItem Header="TranslationEntry">
                <ListBox ItemsSource="{Binding TranslationEntryProcedures}" Background="Transparent"
                         DragDrop.AllowDrop="True" Name="TranslationEntryListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:ProcedureItemViewModel">
                            <Border Background="Transparent" PointerPressed="OnPointerPressed">
                                <Grid ColumnDefinitions="Auto, *, Auto" Margin="4,2">
                                    <TextBlock Grid.Column="0" Text="↕ " Foreground="Gray" VerticalAlignment="Center" ToolTip.Tip="드래그하여 순서를 변경하세요"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="10" 
                    Margin="0,12,0,0">
    
            <Button Content="적용" Command="{Binding ApplyCommand}" />
            <Button Content="저장" Command="{Binding SaveCommand}" />
            <Button Content="닫기" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>