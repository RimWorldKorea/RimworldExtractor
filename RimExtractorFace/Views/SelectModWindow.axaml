<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RimExtractorFace.ViewModels"
        x:Class="RimExtractorFace.Views.SelectModWindow"
        x:DataType="vm:SelectModViewModel"
        Title="추출 모드 선택"
        Width="700" Height="900"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="CheckBox.SettingArea /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        
        <Style Selector="CheckBox.SettingArea:checked /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        
        <!-- 선택 모드 하이라이트 -->
        <Style Selector="Grid.ModListItem.ExtractionTarget">
            <Setter Property="Background" Value="#330078D7"/>
        </Style>
    </Window.Styles>
    
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="12" RowSpacing="10">
        
        <!-- 1행: 검색 및 selected 정보 -->
        <Border Grid.Row="0" Background="Black" CornerRadius="4" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding SelectedModInfoText}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- 2행: 검색창 및 필터 옵션 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
            
            <!-- 자동 참조 토글 스위치 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="참조 모드 자동 선택" VerticalAlignment="Center"/>
                <CheckBox Classes="SettingArea"
                          IsChecked="{Binding AutoReferenceLink, Mode=TwoWay}"
                          Padding="0"/>
            </StackPanel>
            
            <!-- 검색창 -->
            <TextBox Grid.Column="1" 
                     Text="{Binding SearchText, Mode=TwoWay}" 
                     VerticalContentAlignment="Center"
                     PlaceholderText="모드 이름 또는 PackageID로 검색"/>
            
            <!-- 선택 모드만 보기 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <CheckBox Classes="SettingArea"
                          IsChecked="{Binding IsFilterSelectedOnly, Mode=TwoWay}"
                          Padding="0"/>
                <TextBlock Text="선택 모드만 보기" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>

        <!-- 3행: 모드 리스트 및 폴더 리스트 -->
        <Border Grid.Row="2" Background="#252525" CornerRadius="4" Grid.IsSharedSizeScope="True">
                
            <ListBox ItemsSource="{Binding FilteredMods}" 
                     SelectedItem="{Binding SelectedModListItem}"
                     Background="Transparent"
                     ScrollViewer.AllowAutoHide="False"
                     Padding="3,1,3,3"> <!-- 내부 전체 여백도 살짝 줄임 -->
                         
                <ListBox.Styles>
                    <!-- 1. [헤더 비활성화 & 행 높이 압축] -->
                    <Style Selector="ListBoxItem" x:DataType="vm:ModListItem">
                        <!-- 헤더 아이템일 경우 IsEnabled를 False로 만들어 마우스 호버와 선택을 원천 차단 -->
                        <Setter Property="IsEnabled" Value="{Binding !IsHeader}"/>
                        <!-- <Setter Property="MinHeight" Value="10"/> -->
                        <Setter Property="Padding" Value="4,0"/>
                    </Style>
                    <!-- 비활성화(Disabled) 상태일 때 흐려지지 않도록 불투명도 원상복구 -->
                    <Style Selector="ListBoxItem:disabled">
                        <Setter Property="Opacity" Value="1.0" />
                    </Style>
                </ListBox.Styles>
                    
                <ListBox.ItemTemplate>
                    
                    <DataTemplate DataType="vm:ModListItem">
                        <Panel>
                                
                            <!-- 헤더 UI -->
                            <Border IsVisible="{Binding IsHeader}" 
                                    Background="#333333" 
                                    CornerRadius="4"
                                    Padding="6"
                                    Margin="0,6">
                                <TextBlock Text="{Binding HeaderText}" 
                                           FontWeight="Bold" 
                                           Foreground="White" 
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- 아이템 UI (진짜 모드) -->
                            <!-- 위아래 여백을 최소화하여 컴팩트하게 만듦 -->
                            <Grid Classes="ModListItem"
                                  Classes.ExtractionTarget="{Binding IsExtractionTarget}"
                                  IsVisible="{Binding !IsHeader}"
                                  ColumnSpacing="4"
                                  Margin="0,1,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" 
                                                      SharedSizeGroup="IdColumnGroup" 
                                                      MinWidth="{Binding MinIdWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                    
                                <!-- 2. [ID 중앙 정렬] -->
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding DisplayId}" 
                                           Foreground="Gray" 
                                           HorizontalAlignment="Center" 
                                           TextAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                               
                                <!-- 이름 -->
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding DisplayName}" 
                                           VerticalAlignment="Center" 
                                           TextTrimming="CharacterEllipsis"/>
                                               
                                <!-- 체크박스 -->
                                <CheckBox Grid.Column="2" 
                                          IsChecked="{Binding IsReference, Mode=TwoWay}" 
                                          MinHeight="16"/>
                            </Grid>
                                
                        </Panel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                    
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="파일 탐색기에서 모드 폴더 열기" Command="{Binding OpenExplorerCommand}"/>
                        <Separator Padding="-2,0"/>
                        <MenuItem Header="참조 모드 자동 선택" Command="{Binding SelectAllRefModsCommand}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Border>
            
        <!-- 모드 목록 로딩 중 표시 오버레이 -->
        <Border Grid.Row="2" Background="#B3252525" CornerRadius="4" 
                IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="모드 목록을 불러오는 중입니다..." 
                           FontSize="16" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
  

        <!-- 5행: 완료 버튼 -->
        <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="10" Height="40">
            
            <Button Grid.Column="0" 
                    Content="초기화"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ResetSelectionCommand}"/>

            <Button Grid.Column="1" 
                    Content="선택 완료" 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding CompleteCommand}"/>
                    
        </Grid>
        
    </Grid>
</Window>