<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RimExtractorFace.ViewModels"
        x:Class="RimExtractorFace.Views.SelectModWindow"
        x:DataType="vm:SelectModViewModel"
        Title=""
        Width="820" Height="520"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">

    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto" Margin="12">
        <!-- 1행: 검색 및 selected 정보 -->
        <Grid Grid.Row="0" ColumnDefinitions="*, *" Margin="0,0,0,8">
            <StackPanel Grid.Column="0">
                <TextBlock Text="추출할 모드를 선택하세요" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="모드 이름/ID 검색..."/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="선택된 모드 정보" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border Background="Black" CornerRadius="4" Padding="8" Height="50">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SelectedModInfoText}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2행: 필터 옵션 -->
        <DockPanel Grid.Row="1" Margin="0,4,0,8">
            <CheckBox Content="선택한 모드만 보기 (S로 참조선택 가능)" 
                      IsChecked="{Binding IsFilterSelectedOnly, Mode=TwoWay}"
                      DockPanel.Dock="Right"/>
            <TextBlock Text="추출할 폴더 선택 (우측)" VerticalAlignment="Center" Foreground="Gray"/>
        </DockPanel>

        <!-- 3행: 모드 리스트 및 폴더 리스트 -->
        <!-- 3. 본문 목록 -->
        <!-- 3. 본문 목록 -->
        <Grid Grid.Row="2" ColumnDefinitions="*, 300" Margin="0,0,0,8">
            
            <!-- 좌측: 모드 목록 -->
            <Border Grid.Column="0" Background="#252525" CornerRadius="4" Margin="0,0,8,0" Grid.IsSharedSizeScope="True">
                
                <ListBox ItemsSource="{Binding FilteredMods}" 
                         SelectedItem="{Binding SelectedModListItem}"
                         Background="Transparent"
                         ScrollViewer.AllowAutoHide="False"
                         Padding="4,4,0,4"> <!-- 내부 전체 여백도 살짝 줄임 -->
                         
                    <ListBox.Styles>
                        <!-- 1. [헤더 비활성화 & 행 높이 압축] -->
                        <Style Selector="ListBoxItem" x:DataType="vm:ModListItem">
                            <!-- 헤더 아이템일 경우 IsEnabled를 False로 만들어 마우스 호버와 선택을 원천 차단 -->
                            <Setter Property="IsEnabled" Value="{Binding !IsHeader}"/>
                            <Setter Property="MinHeight" Value="22"/>
                            <Setter Property="Padding" Value="4,1"/>
                        </Style>
                        <!-- 비활성화(Disabled) 상태일 때 흐려지지 않도록 불투명도 원상복구 -->
                        <Style Selector="ListBoxItem:disabled">
                            <Setter Property="Opacity" Value="1.0" />
                        </Style>
                    </ListBox.Styles>
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:ModListItem">
                            <Panel>
                                
                                <!-- 헤더 UI -->
                                <Border IsVisible="{Binding IsHeader}" 
                                        Background="#333333" 
                                        CornerRadius="4" 
                                        Padding="6,4" 
                                        Margin="0,4,0,4">
                                    <TextBlock Text="{Binding HeaderText}" 
                                               FontWeight="Bold" 
                                               Foreground="White" 
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- 아이템 UI (진짜 모드) -->
                                <!-- 위아래 여백을 최소화하여 컴팩트하게 만듦 -->
                                <Grid IsVisible="{Binding !IsHeader}" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" 
                                                          SharedSizeGroup="IdColumnGroup" 
                                                          MinWidth="{Binding MinIdWidth}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- 2. [ID 중앙 정렬] -->
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding DisplayId}" 
                                               Foreground="Gray" 
                                               HorizontalAlignment="Center" 
                                               TextAlignment="Center" 
                                               VerticalAlignment="Center" 
                                               Margin="4,0,12,0"/>
                                               
                                    <!-- 이름 -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding DisplayName}" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="CharacterEllipsis"/>
                                               
                                    <!-- 체크박스 -->
                                    <CheckBox Grid.Column="2" 
                                              IsChecked="{Binding IsReference, Mode=TwoWay}" 
                                              MinHeight="16" 
                                              Margin="8,0,6,0"/>
                                </Grid>
                                
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="탐색기 열기" Command="{Binding OpenExplorerCommand}"/>
                            <Separator/>
                            <MenuItem Header="선택 모드의 기준(참조) 모드 모두 가져오기" Command="{Binding SelectAllRefModsCommand}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>

            <!-- 우측: 폴더 목록 (기존 유지) -->
            <ListBox Grid.Column="1" Name="ListBoxFolders" ItemsSource="{Binding ExtractableFolders}" SelectionMode="Multiple,Toggle">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" ToolTip.Tip="{Binding FullPath}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 4행: 조작법 안내 -->
        <TextBlock Grid.Row="3" Text="조작법: '좌클릭' = 추출 모드 선택 | '우클릭' = 메뉴 | 'A' = 탐색기 열기 | 'D' = 선택 모드만 보기"
                   Foreground="White" FontSize="11" Margin="0,0,0,8" HorizontalAlignment="Center"/>

        <!-- 5행: 완료 버튼 -->
        <Button Grid.Row="4" Content="선택 완료" Height="40" 
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Command="{Binding CompleteCommand}"/>
    </Grid>
</Window>