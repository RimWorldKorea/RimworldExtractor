<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RimExtractorFace.ViewModels"
        x:Class="RimExtractorFace.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="일반 설정"
        Width="640"
        SizeToContent="Height"
        Foreground="White"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        
        <Style Selector="Border.SettingGroup">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="LightGray" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="10" />
        </Style>
    </Window.Styles>
    
    <Grid RowDefinitions="*, Auto" Margin="10">

        <StackPanel Spacing="10">
                
            <!-- 1. 경로 설정 -->
            <Border Classes="SettingGroup">
                <StackPanel Spacing="5">
                    <TextBlock Text="경로 설정" FontWeight="Bold" TextAlignment="Center"/>
                    
                    <TextBlock Text="림월드 설치 경로" Margin="0,5,0,0"/>
                    
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBox Grid.Column="0" Text="{Binding settings.PathRimworld, Mode=TwoWay}"/>
                        <Button Grid.Column="1" Content="..." Width="40" HorizontalContentAlignment="Center"
                                Command="{Binding SelectPathRimworldCommand}"
                                CommandParameter="{Binding $parent[Window].StorageProvider}"/>
                    </Grid>
                    
                    <TextBlock Text="창작마당 폴더 경로" Margin="0,5,0,0"/>
                    
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBox Grid.Column="0" Text="{Binding settings.PathWorkshop, Mode=TwoWay}"/>
                        <Button Grid.Column="1" Content="..." Width="40" HorizontalContentAlignment="Center"
                                Command="{Binding SelectPathWorkshopCommand}"
                                CommandParameter="{Binding $parent[Window].StorageProvider}"/>
                    </Grid>
                    
                    <TextBlock Text="현재 버전" Margin="0,5,0,0"/>
                    
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <TextBox Grid.Column="0" Text="{Binding gameVersion, Mode=TwoWay}"/>
                        <Button Grid.Column="1" Content="자동 감지" Command="{Binding AutoDetectVersionCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. 추출 및 저장 설정 -->
            <Border Classes="SettingGroup">
                <StackPanel Spacing="5">
                    <TextBlock Text="언어 및 추출 설정" FontWeight="Bold" TextAlignment="Center"/>
                    
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="5" Margin="0,5,0,0">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="주 추출 언어"/>
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding settings.OriginalLanguage, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="보조 추출 언어"/>
                            <ComboBox ItemsSource="{Binding SecondaryLanguages}"
                                      SelectedItem="{Binding SelectedSecondaryLanguage, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="번역(목표) 언어"/>
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding settings.TranslationLanguage, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- 추출 방식 / 중복 처리 정책 -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="5" Margin="0,5,0,0" >
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="저장 포맷"/>
                            <ComboBox ItemsSource="{Binding ExtractionMethods}"
                                      SelectedIndex="{Binding SelectedExtractionMethodIndex, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="중복 처리"/>
                            <ComboBox ItemsSource="{Binding DuplicationPolicies}"
                                      SelectedIndex="{Binding SelectedPolicyIndex, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                    
                </StackPanel>
            </Border>
                
        </StackPanel>

        <!-- 하단 버튼들 -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="10" 
                    Margin="0,10,0,0">
    
            <Button Content="적용" Command="{Binding ApplyCommand}" Width="60"/>
            <Button Content="저장" Command="{Binding SaveCommand}" Width="60"/>
            <Button Content="닫기" Command="{Binding CloseCommand}" Width="60"/>
        </StackPanel>
    </Grid>
</Window>