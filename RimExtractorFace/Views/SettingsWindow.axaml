<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RimExtractorFace.ViewModels"
        x:Class="RimExtractorFace.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="설정"
        Width="500" Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*, Auto" Margin="12">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Margin="4">
                
                <!-- 1. 경로 설정 -->
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="경로 설정" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,4"/>
                        <TextBlock Text="Rimworld 설치 경로:"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding Config.PathRimworld, Mode=TwoWay}" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="..." Width="40" HorizontalContentAlignment="Center"
                                    Command="{Binding SelectPathRimworldCommand}"
                                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
                        </Grid>
                        <TextBlock Text="창작마당 폴더 경로:" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding Config.PathWorkshop, Mode=TwoWay}" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="..." Width="40" HorizontalContentAlignment="Center"
                                    Command="{Binding SelectPathWorkshopCommand}"
                                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*, *" Margin="0,4,0,0">
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="버전 인식 정규식:"/>
                                <TextBox Text="{Binding Config.PatternVersion, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="현재 버전:"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Grid.Column="0" Text="{Binding Config.CurrentVersion, Mode=TwoWay}" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="자동 감지" Command="{Binding AutoDetectVersionCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. 추출 및 저장 설정 -->
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="추출 및 저장 설정" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="원본 언어:"/>
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Config.OriginalLanguage, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="번역 언어:"/>
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Config.TranslationLanguage, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*, *" Margin="0,4,0,0">
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="저장 방식:"/>
                                <ComboBox ItemsSource="{Binding ExtractionMethods}" SelectedIndex="{Binding SelectedExtractionMethodIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="중복 정책:"/>
                                <ComboBox ItemsSource="{Binding DuplicationPolicies}" SelectedIndex="{Binding SelectedPolicyIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="기본 참조 모드 리스트 경로 (.refMods):" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding Config.PathBaseRefList, Mode=TwoWay}" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="..." Width="40" HorizontalContentAlignment="Center"
                                    Command="{Binding SelectBaseRefListCommand}"
                                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>

        <!-- 하단 버튼들 -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto, Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="일부 설정은 재시작 후 적용됩니다." VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
            <Button Grid.Column="1" Content="저장 및 닫기" Margin="0,0,8,0" Command="{Binding SaveAndCloseCommand}"/>
            <Button Grid.Column="2" Content="취소" Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
            <Button Grid.Column="3" Content="초기화" Command="{Binding ResetCommand}"/>
        </Grid>
    </Grid>
</Window>