<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RimExtractorFace.ViewModels"
        x:Class="RimExtractorFace.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="일반 설정"
        Width="600"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*, Auto" Margin="12">

        <StackPanel Spacing="10" Margin="4">
                
            <!-- 1. 경로 설정 -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="경로 설정" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,4"/>
                    <TextBlock Text="Rimworld 설치 경로:"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" Text="{Binding settings.PathRimworld, Mode=TwoWay}" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="..." Width="40" HorizontalContentAlignment="Center"
                                Command="{Binding SelectPathRimworldCommand}"
                                CommandParameter="{Binding $parent[Window].StorageProvider}"/>
                    </Grid>
                    <TextBlock Text="창작마당 폴더 경로:" Margin="0,4,0,0"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" Text="{Binding settings.PathWorkshop, Mode=TwoWay}" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="..." Width="40" HorizontalContentAlignment="Center"
                                Command="{Binding SelectPathWorkshopCommand}"
                                CommandParameter="{Binding $parent[Window].StorageProvider}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*" Margin="0,4,0,0">
                        <StackPanel Grid.Column="0" Margin="4,0,0,0">
                            <TextBlock Text="현재 버전:"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0" Text="{Binding gameVersion, Mode=TwoWay}" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="자동 감지" Command="{Binding AutoDetectVersionCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. 추출 및 저장 설정 -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="언어 및 추출 설정" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,4"/>
                    
                    <Grid ColumnDefinitions="*, *">
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="1차 추출 언어:"/>
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding settings.OriginalLanguage, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="2차 추출 언어:"/>
                            <ComboBox ItemsSource="{Binding SecondaryLanguages}" SelectedItem="{Binding SelectedSecondaryLanguage, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="번역(목표) 언어:"/>
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding settings.TranslationLanguage, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- 추출 방식 / 중복 처리 정책 -->
                    <Grid ColumnDefinitions="*, *" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="추출 방식:"/>
                            <ComboBox ItemsSource="{Binding ExtractionMethods}" SelectedIndex="{Binding SelectedExtractionMethodIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="중복 번역 처리:"/>
                            <ComboBox ItemsSource="{Binding DuplicationPolicies}" SelectedIndex="{Binding SelectedPolicyIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                        
                    <TextBlock Text="레퍼런스 모드 목록 (.refMods):" Margin="0,8,0,0"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" Text="{Binding settings.PathBaseRefList, Mode=TwoWay}" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="..." Width="40" HorizontalContentAlignment="Center"
                                Command="{Binding SelectBaseRefListCommand}"
                                CommandParameter="{Binding $parent[Window].StorageProvider}"/>
                    </Grid>
                </StackPanel>
            </Border>
                
        </StackPanel>

        <!-- 하단 버튼들 -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="10" 
                    Margin="0,13,0,0">
    
            <Button Content="적용" Command="{Binding ApplyCommand}" />
            <Button Content="저장" Command="{Binding SaveCommand}" />
            <Button Content="닫기" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>