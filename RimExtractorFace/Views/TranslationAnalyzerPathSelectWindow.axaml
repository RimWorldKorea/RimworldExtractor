<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RimExtractorFace.ViewModels"
        x:Class="RimExtractorFace.Views.TranslationAnalyzerPathSelectWindow"
        x:DataType="vm:TranslationAnalyzerPathSelectViewModel"
        Title="분석 파일 지정"
        Width="600"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Spacing="10" Margin="10">
        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="5">
            <TextBox Grid.Column="0" Text="{Binding PathText, Mode=TwoWay}"/>
            <Button Grid.Column="1" Content="스프레드시트 선택"
                    Command="{Binding SelectSingleFileCommand}"
                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
            <Button Grid.Column="2" Content="폴더 선택"
                    Command="{Binding SelectDirCommand}"
                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
        </Grid>

        <Border Background="#252525" Padding="10">
            <TextBlock Text="Q. 번역 분석기가 뭔가요?&#10;A. 기존에 추출했던 엑셀 파일들을 분석하여, 모드 업데이트로 인해 원문이 변경되었거나 새로 추가된 노드가 있는지 알려주고 자동으로 수정해줍니다."
                       TextWrapping="Wrap" VerticalAlignment="Center" Foreground="White"/>
        </Border>

        <Button Content="실행" Height="36" 
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                Command="{Binding CompleteCommand}"/>
    </StackPanel>
</Window>