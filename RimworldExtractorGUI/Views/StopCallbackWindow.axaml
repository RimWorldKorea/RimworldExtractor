<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RimworldExtractorGUI.ViewModels"
        x:Class="RimworldExtractorGUI.Views.StopCallbackWindow"
        x:DataType="vm:StopCallbackViewModel"
        Title="중복되는 파일"
        Width="360" Height="150"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="12" Spacing="8">
        <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="#333333"/>
        <TextBlock Text="파일 저장 중 중복되는 파일을 발견했습니다." HorizontalAlignment="Center" FontWeight="Bold"/>

        <Grid ColumnDefinitions="*, *" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="덮어씌우기" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0"
                    Command="{Binding OverwriteCommand}"/>
            <Button Grid.Column="1" Content="건너뛰기" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0"
                    Command="{Binding SkipCommand}"/>
        </Grid>
    </StackPanel>
</Window>