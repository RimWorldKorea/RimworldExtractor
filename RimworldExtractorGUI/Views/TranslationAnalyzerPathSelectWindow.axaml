<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RimworldExtractorGUI.ViewModels"
        x:Class="RimworldExtractorGUI.Views.TranslationAnalyzerPathSelectWindow"
        x:DataType="vm:TranslationAnalyzerPathSelectViewModel"
        Title="엑셀 파일 경로 지정"
        Width="600" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto, *, Auto" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" Text="{Binding PathText, Mode=TwoWay}" Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="엑셀 파일 선택" Margin="0,0,4,0"
                    Command="{Binding SelectSingleFileCommand}"
                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
            <Button Grid.Column="2" Content="폴더 선택"
                    Command="{Binding SelectDirCommand}"
                    CommandParameter="{Binding $parent[Window].StorageProvider}"/>
        </Grid>

        <Border Grid.Row="1" Background="#F8F8F8" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <TextBlock Text="Q. 번역 분석기가 뭔가요?&#10;A. 기존에 추출했던 엑셀 파일들을 분석하여, 모드 업데이트로 인해 원문이 변경되었거나 새로 추가된 노드가 있는지 알려주고 자동으로 수정해줍니다."
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Border>

        <Button Grid.Row="2" Content="선택 완료" Height="36" 
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                Command="{Binding CompleteCommand}"/>
    </Grid>
</Window>